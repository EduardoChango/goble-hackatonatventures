# Entorno: local | dev | prod
APP_ENV=local

# true => los adapters de APIs externas leen mocks/external_apis en lugar de llamar HTTP
USE_MOCKS=true
MOCKS_DIR=./mocks/external_apis

# PostgreSQL local (db/docker-compose.yml)
DATABASE_URL=postgresql://goble:goble@localhost:5432/tratamiento

# Persistencia: si está vacío se usa el repositorio en memoria
JOBS_TABLE_NAME=

# API externa real (cuando USE_MOCKS=false)
PROVIDER_API_URL=https://api.provider.example.com
PROVIDER_API_KEY=

# Frontend
BACKEND_MODE=local            # local (usa el core en proceso) | http (API Gateway)
API_BASE_URL=                 # URL de API Gateway cuando BACKEND_MODE=http
BFF_URL=http://localhost:5000 # URL del Flask BFF que consume Streamlit
