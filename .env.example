# Variables de tratamiento-app en local. Todas son opcionales.
# La app no lee este archivo sola: defínelas en la terminal, por ejemplo en PowerShell:
#   $Env:DATABASE_URL = "postgresql://goble:goble@localhost:5432/tratamiento"

# PostgreSQL local (db/docker-compose.yml). Sin esta variable la app usa data/state.json
DATABASE_URL=postgresql://goble:goble@localhost:5432/tratamiento

# Lectura de recetas con IA (ai.py). Sin clave, la app devuelve una receta de ejemplo
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Firma de las cookies de sesión del login (en AWS la genera Secrets Manager)
SECRET_KEY=solo-para-desarrollo-local

# Puerto del servidor local
PORT=5000
